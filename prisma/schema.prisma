// Prisma schema — single source of truth data model
// Fase 1: Bible System dengan versioning

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Fase 1: Project & Story =====
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  contentType String
  genre       String
  tone        String
  audience    String
  platform    String
  duration    Int?
  aspectRatio String
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stories          Story[]
  characters       Character[]
  locations        Location[]
  props            Prop[]
  characterBibles  CharacterBible[]
  locationBibles   LocationBible[]
  propBibles       PropBible[]
  styleBibles      StyleBible[]
  scenes           Scene[]
  generationJobs   GenerationJob[]
}

// ===== Refactor: Character/Location/Prop sebagai identitas stabil =====
// Identitas terpisah dari versi data (*Bible). id di sini TIDAK PERNAH
// berubah sepanjang umur entitas, beda dengan CharacterBible.id yang
// berganti tiap versi baru dibuat. Ini yang membuat Scene bisa punya FK
// sungguhan (lewat SceneCharacter/SceneProp/Scene.locationEntityId di bawah)
// tanpa harus ikut berubah tiap kali Bible naik versi.
model Character {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterId String // business ID, mis. "A01" — stabil, ditentukan saat entitas pertama dibuat
  createdAt   DateTime @default(now())

  bibleVersions   CharacterBible[]
  sceneCharacters SceneCharacter[]

  @@unique([projectId, characterId])
  @@index([projectId])
}

model Location {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locationId String // business ID, mis. "L01"
  createdAt  DateTime @default(now())

  bibleVersions LocationBible[]
  scenes        Scene[]

  @@unique([projectId, locationId])
  @@index([projectId])
}

model Prop {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  propId    String // business ID, mis. "O01"
  createdAt DateTime @default(now())

  bibleVersions PropBible[]
  sceneProps    SceneProp[]

  @@unique([projectId, propId])
  @@index([projectId])
}

model Story {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept           String
  premise           String
  synopsis          String
  structure         String?
  timeline          String?
  creativeDirection String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId])
}

// ===== Fase 1: Character Bible (dengan versioning) =====
model CharacterBible {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterEntityId String
  character         Character @relation(fields: [characterEntityId], references: [id], onDelete: Cascade)
  characterId       String // mis. A01, A02 — denormalized dari Character.characterId, tetap dipertahankan
                            // agar query yang sudah ada (validateCharacters, checkScene, dst) tidak berubah.
  version           Int
  name              String
  role              String
  age               String
  gender            String
  identityDesc      String
  faceShape         String
  eyeColor          String
  skinColor         String
  distinctiveFeatures String?
  defaultExpression String
  height            String
  build             String
  posture           String?
  hairColor         String
  hairLength        String
  hairTexture       String
  hairDefaultStyle  String
  personality       Json?
  wardrobes         Json // array of wardrobe sets
  referenceImages   Json?
  status            String   @default("draft") // draft → review → approved → rejected
  isMinorRevision   Boolean  @default(false)
  previousVersionId String? @unique
  previousVersion   CharacterBible? @relation("CharacterVersionHistory", fields: [previousVersionId], references: [id])
  nextVersion       CharacterBible? @relation("CharacterVersionHistory")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, characterId, version])
  @@index([projectId, characterId])
  @@index([characterEntityId])
}

// ===== Fase 1: Location Bible (dengan versioning) =====
model LocationBible {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locationEntityId  String
  location          Location @relation(fields: [locationEntityId], references: [id], onDelete: Cascade)
  locationId        String // mis. L01, L02 — denormalized dari Location.locationId
  version           Int
  name              String
  exterior          Json?
  interior          Json?
  architecture      Json?
  lighting          Json
  atmosphere        String
  referenceImages   Json?
  status            String   @default("draft")
  isMinorRevision   Boolean  @default(false)
  previousVersionId String? @unique
  previousVersion   LocationBible? @relation("LocationVersionHistory", fields: [previousVersionId], references: [id])
  nextVersion       LocationBible? @relation("LocationVersionHistory")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, locationId, version])
  @@index([projectId, locationId])
  @@index([locationEntityId])
}

// ===== Fase 1: Prop Bible (dengan versioning) =====
model PropBible {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  propEntityId      String
  prop              Prop     @relation(fields: [propEntityId], references: [id], onDelete: Cascade)
  propId            String // mis. O01, O02 — denormalized dari Prop.propId
  version           Int
  name              String
  appearance        Json
  function          String
  continuity        Json
  referenceImages   Json?
  status            String   @default("draft")
  isMinorRevision   Boolean  @default(false)
  previousVersionId String? @unique
  previousVersion   PropBible? @relation("PropVersionHistory", fields: [previousVersionId], references: [id])
  nextVersion       PropBible? @relation("PropVersionHistory")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, propId, version])
  @@index([projectId, propId])
  @@index([propEntityId])
}

// ===== Fase 2: Scene =====
model Scene {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeId    String?
  sceneNumber  Int
  title        String?
  characterIds Json // array of Character ID (mis. ["A01", "A02"]) — TETAP sumber kebenaran
                     // untuk logic bisnis (validasi, continuity check). sceneCharacters di
                     // bawah adalah representasi FK-enforced yang disinkronkan otomatis,
                     // ditambahkan khusus untuk jaminan integritas di level database.
  locationId   String // Location ID (mis. "L01") — tetap sumber kebenaran, lihat locationEntityId
  locationEntityId String?
  location     Location? @relation(fields: [locationEntityId], references: [id], onDelete: Restrict)
  propIds      Json? // array of Prop ID (mis. ["O01"]) — tetap sumber kebenaran, lihat sceneProps
  time         String
  action       String
  emotions     Json // array of { characterId, emotion }
  dialogues    Json? // array of { characterId, line, order }
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shots            Shot[]
  continuityFlags  ContinuityFlag[]
  sceneCharacters  SceneCharacter[]
  sceneProps       SceneProp[]

  @@unique([projectId, sceneNumber])
  @@index([projectId])
  @@index([locationEntityId])
}

// Join table FK-enforced antara Scene dan Character (many-to-many).
// Disinkronkan otomatis oleh SceneService setiap kali Scene.characterIds berubah —
// lihat catatan di SceneService.syncCharacterEntities.
model SceneCharacter {
  sceneId           String
  scene             Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characterEntityId String
  character         Character @relation(fields: [characterEntityId], references: [id], onDelete: Restrict)

  @@id([sceneId, characterEntityId])
  @@index([characterEntityId])
}

// Join table FK-enforced antara Scene dan Prop (many-to-many).
// Disinkronkan otomatis oleh SceneService setiap kali Scene.propIds berubah.
model SceneProp {
  sceneId      String
  scene        Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  propEntityId String
  prop         Prop  @relation(fields: [propEntityId], references: [id], onDelete: Restrict)

  @@id([sceneId, propEntityId])
  @@index([propEntityId])
}

// ===== Fase 3: Shot (Storyboard Engine) =====
model Shot {
  id                String   @id @default(uuid())
  sceneId           String
  scene             Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  projectId         String
  shotNumber        Int
  shotType          String // extreme-wide | wide | medium | close-up | extreme-close-up | over-the-shoulder | pov
  framing           String
  composition       String
  cameraPosition    String // eye-level | high-angle | low-angle | birds-eye | worms-eye
  lens              String?
  cameraMovement    String? // static | pan | tilt | dolly | tracking | handheld | crane | zoom
  characterBlocking Json? // array of { characterId, position, orientation }
  visualBeat        String
  status            String   @default("draft")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  continuityFlags   ContinuityFlag[]
  generationJobs    GenerationJob[]

  @@unique([sceneId, shotNumber])
  @@index([sceneId])
  @@index([projectId])
}

// ===== Fase 2: ContinuityFlag =====
model ContinuityFlag {
  id          String   @id @default(uuid())
  sceneId     String
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shotId      String?
  shot        Shot?    @relation(fields: [shotId], references: [id], onDelete: Cascade)
  projectId   String
  flagType    String // character_id | wardrobe | location_id | prop_id | time | scene_relationship | style | shot_blocking
  fieldName   String
  expectedValue String
  actualValue   String
  description String
  status      String   @default("unresolved") // unresolved → resolved(fixed) | resolved(accepted)
  resolutionNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sceneId])
  @@index([shotId])
  @@index([sceneId, status])
  @@index([shotId, status])
  @@index([projectId, status])
}

// ===== Fase 4: GenerationJob =====
// Mencatat setiap job generation (image/video) dengan versi prompt dan Bible
// yang dipakai saat submit, untuk auditability (lihat CLAUDE.md — Konvensi Kode).
model GenerationJob {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shotId           String
  shot             Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  type             String // image | video
  adapterName      String // flux | seedance | veo | kling | wan | runway
  status           String   @default("pending") // pending → approved → submitted → processing → completed | failed | rejected | cancelled
  promptConceptual String // prompt konseptual (netral terhadap model)
  promptFinal      String? // prompt final setelah diterjemahkan adapter
  promptVersion    Int      @default(1)
  bibleVersions    Json // snapshot versi Bible yang dipakai: { character: { A01: 2 }, location: { L01: 1 }, prop: { O01: 1 }, style: 3 }
  costEstimate     Float
  costActual       Float?
  currency         String   @default("USD")
  outputAssetUrl   String?
  errorMessage     String?
  metadata         Json? // metadata tambahan dari adapter (seed, parameter, dst)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectId])
  @@index([shotId])
  @@index([projectId, status])
  @@index([adapterName])
}

// ===== Fase 4: AdapterPricingRate =====
// Rate harga generation per adapter, dikelola internal (bukan fetch live dari API provider).
// Diupdate manual lewat dashboard admin sederhana (lihat PRD.md 10.3).
model AdapterPricingRate {
  id            String   @id @default(uuid())
  adapterName   String // flux | seedance | veo | kling | wan | runway
  generationType String // image | video
  rateStructure Json // struktur harga: { unit: "per_image" | "per_second" | "per_resolution", baseRate: number, resolutionMultipliers?: {...}, ... }
  currency      String   @default("USD")
  effectiveDate DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([adapterName, generationType])
  @@index([isActive])
}

// ===== Fase 1: Style Bible (dengan versioning) =====
model StyleBible {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version           Int
  visualStyle       String
  colorPalette      String
  colorSaturation   String
  colorContrast     String
  lightingApproach  String
  lightingTendency  String
  texture           String?
  framingPreference String
  lensPreference    String?
  cameraMovementTendency String
  motionStyle       Json?
  status            String   @default("draft")
  isMinorRevision   Boolean  @default(false)
  previousVersionId String? @unique
  previousVersion   StyleBible? @relation("StyleVersionHistory", fields: [previousVersionId], references: [id])
  nextVersion       StyleBible? @relation("StyleVersionHistory")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
}